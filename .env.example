# Curiosity Machine Environment Configuration

# Google Gemini API key from Google AI Studio (free tier)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model identifier (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database URL
DATABASE_URL=sqlite+aiosqlite:///./curiosity.db

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server host and port
HOST=127.0.0.1
PORT=8000

# Per-IP rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Force degraded mode (uses Wikipedia links instead of Gemini, useful for testing or when quota exhausted)
FORCE_DEGRADED_MODE=false
